{
  "name": "lousa-ia",
  "version": "0.4.5",
  "private": true,
  "description": "Mãozinha: canvas de terminais de IA com contas (perfis) isoladas",
  "author": "Sidney de Araujo Silva",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/sem-run-as-node.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/sem-run-as-node.mjs electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "smoke": "electron-vite build && node scripts/sem-run-as-node.mjs electron . --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "markdown-it": "14.3.2",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
